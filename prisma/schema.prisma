// Threadform database schema.
// Running on MySQL/MariaDB (e.g. Hostinger's included database) via the
// @prisma/adapter-mariadb driver adapter — see src/lib/prisma.ts. To switch
// to Postgres instead: change `provider` below to "postgresql", drop the
// @db.Text annotations (Postgres's default text type has no length cap so
// they're unnecessary there), install @prisma/adapter-pg + pg, and swap the
// adapter in src/lib/prisma.ts. See README.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Badge {
  New
  BestSeller
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Category-level size guide fallback: a Product's own sizeGuideId (below)
  // wins if set; otherwise the storefront falls back to the category's.
  // Optional by design — most categories won't need one until an admin sets it.
  sizeGuideId String?
  sizeGuide   SizeGuide? @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)

  subcategories Subcategory[]
  products      Product[]

  @@index([sortOrder])
  @@index([sizeGuideId])
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  slug       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String   @db.Text
  categoryId       String
  subcategoryId    String
  price            Int
  salePrice        Int?
  salePct          Int?
  badge            Badge?
  isBestSeller     Boolean  @default(false)
  isActive         Boolean  @default(true)
  // Drives the drawn-SVG placeholder (shape + tint) shown when a product has
  // no uploaded ProductImage rows — mirrors PRODUCTS[].type / .color from the
  // original storefront's garmentSVG(). Ignored once real photos are uploaded.
  placeholderType  String?
  placeholderColor String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Product-specific size guide — overrides the category's, when set.
  // Resolution order (see src/lib/sizeGuide.ts): product's own guide, then
  // its category's guide, then no size guide (Size Guide action is hidden).
  sizeGuideId String?
  sizeGuide   SizeGuide? @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)

  category    Category       @relation(fields: [categoryId], references: [id])
  subcategory Subcategory    @relation(fields: [subcategoryId], references: [id])
  images      ProductImage[]
  variants    Variant[]
  orderItems  OrderItem[]
  reviews     ProductReview[]

  @@index([categoryId, subcategoryId])
  @@index([isBestSeller])
  @@index([isActive])
  @@index([sizeGuideId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Variant {
  id        String @id @default(cuid())
  productId String
  size      String
  sku       String @unique
  stockQty  Int    @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([stockQty])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerName  String
  phone         String
  city          String
  address       String        @db.Text
  paymentMethod PaymentMethod
  status        OrderStatus   @default(PENDING)
  subtotal      Int
  shippingFee   Int
  total         Int
  courierName   String?
  trackingCode  String?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items      OrderItem[]
  statusLogs OrderStatusLog[]

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  productName String
  size        String
  unitPrice   Int
  qty         Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  addresses Address[]
  orders    Order[]
  reviews   ProductReview[]
}

// One review per customer per product (@@unique below) — submitting again
// updates the existing row rather than creating a duplicate (see
// src/app/api/reviews/route.ts). Requires a logged-in Customer account
// (see AGENTS.md-adjacent note in src/app/api/reviews/route.ts for why:
// checkout is guest-first in this app, so this is the minimum bar that
// still stops anonymous/unlimited fake reviews without blocking every
// genuine customer who didn't create an account). isVerifiedPurchase is
// computed at submit time from the Order/OrderItem history, not something
// the customer can set — see src/lib/reviews.ts#hasVerifiedPurchase.
model ProductReview {
  id                 String       @id @default(cuid())
  productId          String
  customerId         String
  rating             Int
  title              String?
  body               String       @db.Text
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([customerId])
}

// A reusable measurement chart. `columns` is a JSON array of column labels
// (e.g. ["Size","Chest","Waist","Length"]) — deliberately not fixed columns
// on SizeGuideEntry, since a shoe size chart and a top size chart need
// entirely different measurement fields, and the business may add new ones
// later. Mirrors the JSON-in-@db.Text pattern Setting.value already uses
// elsewhere in this schema. See src/lib/sizeGuide.ts for the typed wrapper.
model SizeGuide {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  columns     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries    SizeGuideEntry[]
  categories Category[]
  products   Product[]
}

model SizeGuideEntry {
  id          String @id @default(cuid())
  sizeGuideId String
  size        String
  sortOrder   Int    @default(0)
  // JSON object keyed by SizeGuide.columns, e.g. {"Chest":"34","Waist":"28"}.
  values      String @db.Text

  sizeGuide SizeGuide @relation(fields: [sizeGuideId], references: [id], onDelete: Cascade)

  @@index([sizeGuideId])
}

// Homepage promotional banners, admin-managed (Admin → Banners) so nothing
// is hardcoded into React — see src/app/(storefront)/page.tsx.
model Banner {
  id              String    @id @default(cuid())
  heading         String
  description     String?   @db.Text
  ctaText         String?
  ctaUrl          String?
  desktopImageUrl String
  // Falls back to desktopImageUrl on the storefront when unset — a mobile
  // crop is a nice-to-have, not a requirement to publish a banner.
  mobileImageUrl  String?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  // Both optional: null startsAt = visible immediately, null endsAt = runs
  // indefinitely. A banner outside its window is excluded even if isActive.
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Address {
  id         String  @id @default(cuid())
  customerId String
  label      String?
  city       String
  address    String  @db.Text
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model Setting {
  key   String @id
  // JSON-serialized — holds things like the full Terms/Privacy page bodies
  // and the hero slides array, which comfortably exceed MySQL's default
  // 191-char VARCHAR, hence @db.Text here.
  value String @db.Text
}
