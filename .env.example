# --- Site ---
# The real public URL of the storefront in production (e.g. https://hsnbyayat.pk).
# Used to build absolute URLs for the sitemap, robots.txt, and Open Graph/
# Twitter share previews. Defaults to http://localhost:3000 if unset, which
# is fine for local dev but must be set correctly before going live.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database ---
# MySQL/MariaDB connection string — e.g. from Hostinger's hPanel under
# Databases → MySQL Databases (host is usually "localhost" from the app's
# own server). To use Postgres instead, see prisma/schema.prisma for the
# one-line provider switch.
DATABASE_URL="mysql://db_user:db_password@localhost/db_name"

# --- Auth ---
# Secret used to sign admin session JWTs. Generate a real one for production:
#   openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# --- Seed: first admin user (used by prisma/seed.ts) ---
ADMIN_EMAIL="admin@hsnbyayat.pk"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="HSN BY AYAT Admin"

# --- File storage ---
# "local" writes to /public/uploads. "s3" uses the S3-compatible client below
# (Cloudflare R2, AWS S3, etc.) — see src/lib/storage.ts.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Email (admin "forgot password" links) ---
# Without SMTP_HOST set, reset links are printed to the server console
# instead of emailed — fine for local dev, not for production. Any standard
# SMTP provider works (SES, Postmark, Mailgun, Resend's SMTP endpoint, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@hsnbyayat.pk"
